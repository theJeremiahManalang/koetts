# Copy these values from Firebase Console > Project settings > Your apps.
# Add them to .env.local without removing existing server settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=koetts-9bf7f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=koetts-9bf7f
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin configuration. Use the same Firebase project as the web app.
FIREBASE_PROJECT_ID=koetts-9bf7f
# Optional private S3 authentication diagnostic; hosted processing remains disabled.
S3_API_URL=
# Set the exact public origin when a reverse proxy gives Next an internal URL.
# MANGA_APP_ORIGIN=https://your-public-host.example
# Local development only: absolute path to a credential file OUTSIDE the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# On Google Cloud, prefer the runtime's attached service account / ADC.
