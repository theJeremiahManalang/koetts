# Build with --target pipeline for light jobs or --target magi for CPU inference.
FROM ghcr.io/astral-sh/uv:0.11.16 AS uv

FROM python:3.11-slim AS source
COPY --from=uv /uv /uvx /bin/
WORKDIR /workspace
COPY pyproject.toml uv.lock README.md ./
COPY apps/worker apps/worker
COPY packages/engine packages/engine
COPY packages/vision packages/vision
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/tmp/manga-hf-cache \
    MANGA_DATA_ROOT=/tmp/manga-cloud-runtime

FROM source AS pipeline-deps
RUN uv sync --frozen --no-dev --no-editable --package manga-worker --extra cloud --extra api

FROM source AS magi-deps
RUN uv sync --frozen --no-dev --no-editable --package manga-worker --extra cloud --extra api
RUN uv sync --frozen --no-dev --no-editable --package manga-vision --extra cpu --inexact

FROM pipeline-deps AS pipeline
USER 65532:65532
ENV PATH=/opt/venv/bin:$PATH
ENTRYPOINT ["python", "-m", "manga_worker.cloud_runtime"]

FROM magi-deps AS magi
USER 65532:65532
ENV PATH=/opt/venv/bin:$PATH
ENTRYPOINT ["python", "-m", "manga_worker.cloud_runtime"]
